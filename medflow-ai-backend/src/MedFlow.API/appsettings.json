{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "OtpTtlMinutes": 5,
    "OtpResendThrottleSeconds": 45,
    "OtpMaxAttempts": 5,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "IdentityClaimTtlDays": 7
  },
  "QrPayment": {
    "PendingExpiryMinutes": 15
  },
  "SePay": {
    "WebhookApiKey": ""
  },
  "Identity": {
    "HashKey": "",
    "Mode": "dual"
  },
  "ScheduleJobs": {
    "Enabled": true,
    "OutboxIntervalSeconds": 30,
    "LifecycleIntervalMinutes": 10,
    "RollingSlotCheckHours": 6,
    "BatchSize": 50,
    "MaxEmailConcurrency": 5,
    "MaxRetryCount": 3,
    "ProcessingLeaseSeconds": 120,
    "SmtpTimeoutSeconds": 20
  }
}
