{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "OtpTtlMinutes": 5,
    "OtpResendThrottleSeconds": 45,
    "OtpMaxAttempts": 5,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "IdentityClaimTtlDays": 7
  },
  "QrPayment": {
    "PendingExpiryMinutes": 15
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "LoginPermitLimit": 10,
    "RegisterPermitLimit": 5,
    "RefreshPermitLimit": 30,
    "OtpVerifyPermitLimit": 10,
    "OtpResendPermitLimit": 5,
    "AppointmentWritePermitLimit": 10,
    "PaymentQrGeneratePermitLimit": 10,
    "AiRecommendPermitLimit": 15
  },
  "SePay": {
    "WebhookApiKey": ""
  },
  "Identity": {
    "HashKey": "",
    "Mode": "dual"
  },
  "ScheduleJobs": {
    "Enabled": true,
    "OutboxIntervalSeconds": 30,
    "LifecycleIntervalMinutes": 10,
    "RollingSlotCheckHours": 6,
    "BatchSize": 50,
    "MaxEmailConcurrency": 5,
    "MaxRetryCount": 3,
    "ProcessingLeaseSeconds": 120,
    "SmtpTimeoutSeconds": 20
  },
  "Realtime": {
    "MaxGroupsPerConnection": 20,
    "MaxInvocationsPerMinute": 30,
    "MaxReceiveMessageSizeBytes": 8192,
    "MembershipTtlMinutes": 5,
    "PublishTimeoutSeconds": 3,
    "CloseOnAuthenticationExpiration": true
  }
}
