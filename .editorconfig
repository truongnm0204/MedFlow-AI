root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html,md}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.{sh}]
indent_style = space
indent_size = 2
end_of_line = lf
